# --- disclosures (step 2) ---
# BSE needs no key. Nothing to set unless you want fewer/more filings per brief.
DISCLOSURE_LIMIT=5

# --- llm (step 3) ---
# Verified on this Groq account 2026-09-13: llama-3.3-70b-versatile is NOT
# available. Options: openai/gpt-oss-120b, openai/gpt-oss-20b,
# qwen/qwen3.8-27b, qwen/qwen3.6-27b
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
LLM_TEMPERATURE=0
GROQ_API_KEY=

# --- langfuse (step 3) ---
# EU and US are separate hosts; the wrong one returns 401.
# EU: https://cloud.langfuse.com    US: https://us.cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- evals (step 4+) ---
NUMBER_MATCH_TOLERANCE=0.01
